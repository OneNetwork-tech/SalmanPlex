{
  "name": "salmanplex",
  "version": "1.0.0",
  "description": "Self-hosted Plex-style media server: libraries, metadata, HLS transcoding and streaming",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --watch src src/server.js",
    "test": "jest --runInBand",
    "migrate": "node src/db/migrate.js up",
    "migrate:down": "node src/db/migrate.js down",
    "check": "node --check src/server.js && for f in $(find src public -name '*.js'); do node --check $f || exit 1; done"
  },
  "keywords": [
    "media-server",
    "streaming",
    "plex",
    "video"
  ],
  "author": "Salman Yahya",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "hls.js": "^1.7.4",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "umzug": "^3.8.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "sqlite3": "^6.0.1",
    "supertest": "^7.3.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "src/server.js"
}
