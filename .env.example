# --- Required in production ---------------------------------------------------
# Generate with: openssl rand -hex 48
JWT_SECRET=
POSTGRES_PASSWORD=

# --- Database -----------------------------------------------------------------
# Either DATABASE_URL or the discrete POSTGRES_* settings.
# DATABASE_URL=postgres://salmanplex:password@localhost:5432/salmanplex
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=salmanplex
POSTGRES_USER=salmanplex
# POSTGRES_SSL=true

# --- Server -------------------------------------------------------------------
PORT=3000
# Express "trust proxy" setting; set to the number of proxies or their CIDR when behind a reverse proxy.
TRUST_PROXY=loopback
# Served over HTTPS (CSP upgrade-insecure-requests + HSTS); defaults to true in production.
# Set false only to test over plain HTTP on a LAN.
# HTTPS_ONLY=true
# Comma-separated origins allowed to call the API cross-origin (leave empty for same-origin only).
CORS_ORIGIN=
# Allow anyone to self-register after the first (admin) account exists.
ALLOW_REGISTRATION=false
JWT_EXPIRES_IN=12h
STREAM_TOKEN_EXPIRES_IN=8h

# --- Media --------------------------------------------------------------------
# Every library folder must live inside MEDIA_ROOT.
MEDIA_ROOT=./media
CACHE_DIR=./.cache
MAX_UPLOAD_MB=4096
SCAN_ON_STARTUP=false
# Docker compose only: host folder mounted as /media and published port.
MEDIA_PATH=./media
HOST_PORT=3000

# --- Transcoding --------------------------------------------------------------
TRANSCODING_ENABLED=true
MAX_TRANSCODES=2
HLS_SEGMENT_SECONDS=6
TRANSCODE_IDLE_TIMEOUT_S=60
FFMPEG_PRESET=veryfast
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# --- Metadata (optional) --------------------------------------------------------
# TMDb v3 API key or v4 read access token: https://www.themoviedb.org/settings/api
TMDB_API_KEY=
TMDB_LANGUAGE=en-US
